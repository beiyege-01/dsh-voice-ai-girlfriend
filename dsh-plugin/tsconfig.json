{
  // Standalone type-check config for the plugin sources. The build itself is
  // esbuild (`node build.mjs`); `tsc --noEmit` additionally needs the DSH
  // 0.2.x client packages (`@deepseek-ai/dsh-client-*`) resolvable from a
  // harness checkout, so run it from a DSH workspace when you want full types.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src"]
}
